{
  "version": "1.2.0",
  "categories": {
    "Authentication and Security": {
      "keywords": ["auth", "login", "jwt", "mfa", "rbac", "token", "encrypt", "session"],
      "paths": ["auth/", "middleware/", "guards/", "security/"],
      "impact": "feature"
    },
    "Frontend and UI": {
      "keywords": ["component", "render", "hook", "state", "redux", "tailwind", "layout"],
      "paths": ["components/", "pages/", ".tsx", ".jsx", ".vue"],
      "impact": "feature"
    },
    "API and Backend Services": {
      "keywords": ["api", "endpoint", "route", "controller", "graphql", "rpc", "handler"],
      "paths": ["api/", "services/", "controllers/", "routes/"],
      "impact": "feature"
    },
    "Database and Data": {
      "keywords": ["migration", "schema", "query", "prisma", "mongoose", "redis", "index"],
      "paths": ["migrations/", "models/", "db/", "repositories/"],
      "impact": "feature"
    },
    "Infrastructure and DevOps": {
      "keywords": ["deploy", "docker", "k8s", "ci", "lambda", "terraform", "pipeline"],
      "paths": ["infra/", ".github/", "Dockerfile", ".yml"],
      "impact": "ship"
    },
    "Performance and Optimisation": {
      "keywords": ["cache", "lazy", "memo", "bundle", "lighthouse", "throttle", "perf"],
      "paths": ["next.config", "vite.config", "webpack/"],
      "impact": "refactor"
    },
    "Payments and Billing": {
      "keywords": ["payment", "stripe", "billing", "subscription", "invoice", "webhook"],
      "paths": ["payments/", "billing/", "subscriptions/"],
      "impact": "feature"
    },
    "Testing and Quality": {
      "keywords": ["test", "spec", "mock", "jest", "cypress", "coverage", "fixture"],
      "paths": ["__tests__/", ".test.", ".spec.", "e2e/"],
      "impact": "bugfix"
    },
    "Documentation": {
      "keywords": ["doc", "readme", "comment", "guide"],
      "paths": ["docs/", "README", ".md"],
      "impact": "ship"
    }
  }
}
