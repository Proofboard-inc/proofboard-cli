#!/bin/sh
set -e

if [ "$1" = "remove" ] || [ "$1" = "deconfigure" ]; then
    if command -v loginctl >/dev/null 2>&1; then
        loginctl list-users --no-legend 2>/dev/null | while read -r uid user rest; do
            case "$uid" in
                ''|*[!0-9]*) continue ;;
            esac
            if [ "$uid" -ge 1000 ] && [ -n "$user" ]; then
                runuser -u "$user" -- /usr/bin/proofboard agent stop >/dev/null 2>&1 || true
            fi
        done
    fi
fi

exit 0
