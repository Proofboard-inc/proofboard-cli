<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest. MSIX is the format the Microsoft Store and modern Intune
  deployment use, and it installs into a sandboxed per-user location rather
  than Program Files.

  Note that an MSIX will only install if it is signed by a certificate the
  machine trusts. The package produced here is UNSIGNED, so it is usable for
  sideloading on a machine with developer mode enabled, or after signing with
  your own certificate. Publisher below must match the certificate subject
  exactly when it is signed.
-->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
         xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
         IgnorableNamespaces="uap uap3 desktop">

  <Identity Name="Proofboard.CareerAgent"
            Publisher="CN=Proofboard"
            Version="PLACEHOLDER_VERSION"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Proofboard Career Agent</DisplayName>
    <PublisherDisplayName>Proofboard</PublisherDisplayName>
    <Description>Builds your engineering career record locally.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="ProofboardCareerAgent" Executable="proofboard.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Proofboard Career Agent"
                          Description="Builds your engineering career record locally."
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Exposes `proofboard` as a command on PATH, which is the whole
             point of shipping a command-line tool in this format. -->
        <!-- appExecutionAlias is defined in the uap3 namespace; declaring it
             under uap fails manifest validation outright. -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="proofboard.exe"
                        EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="proofboard.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <!--
    On elevation: an MSIX package cannot request administrator rights. The
    format installs per-user into a sandboxed location by design and there is
    no manifest setting that changes it — unlike the MSI, which declares
    InstallPrivileges="elevated" and installs for all users.

    runFullTrust below gives the packaged executable ordinary desktop-app
    access (the file system, the user's repositories, the background agent),
    which is what this tool needs. It is not elevation.

    To deploy machine-wide, an administrator provisions it for every user:
      Add-AppxProvisionedPackage -Online -PackagePath <file>.msix -SkipLicense
    Intune and Store deployment do the equivalent. Anyone needing a
    per-machine install with an elevation prompt should use the MSI.
  -->
  <Capabilities>
    <rescap:Capability Name="runFullTrust"
      xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities" />
  </Capabilities>
</Package>
